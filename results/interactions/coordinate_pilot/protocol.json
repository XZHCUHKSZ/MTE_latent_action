  "port": 8785,
  "scope": "Fixed exploratory architecture pilot, first two existing seeds in each environment. Not original formal retraining or new confirmation.",
  "input": "Simple/Graph/Tree: raw h3 target edges. MIF: original rich three-horizon endpoint+edge tables.",
  "loss": "Common value-coordinate reconstruction MSE + variance floor + .02 covariance. Full visibility for both arms; no coefficient-coordinate loss or masked reconstruction. This symmetric diagnostic objective differs from historical training.",
  "controls": "raw_coordinates replaces only mobius/zeta buffers with identity on new control instances; self_axis replaces only chosen MIF adjacency with identity. Tree upward_only uses existing constructor switch.",
  "fairness": "Within each architecture: identical observations, train/dev indices, initialization, parameter count, minibatches and updates. Report wall time and active gradients; cross-architecture resources are not equated. Tree upward-only disables a sweep and is explicitly not equal FLOPs.",
  "primary": "Per-partner canonical Mobius coefficient skill from native decoder and fixed ridge=.01 linear readout. Also retain whole-edge reconstruction skill.",
  "no_selection": "Report every arm at fixed update400. No dev-based checkpoint/metric/sign selection; retain failures.",
  "stopping": "48 jobs; no automatic expansion based on advantage. Original checkpoints/results are not overwritten.",
  "native_action_labels_read": 0,
  "simulator_queries": 0,
  "history_training": false
